# =============================================================================
# config/.env do Sistema Santos Lourenço Advogados
# Copie para config/.env e preencha. Este arquivo-modelo NAO tem nenhum valor real.
# Campos em branco = modulo correspondente fica desligado (o resto funciona).
# Checklist do que falta do escritorio: docs/ONBOARDING.md
# =============================================================================

# ---------- Ambiente ----------
# producao = exige JWT_SECRET; dev = gera segredo temporario
AMBIENTE=producao
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"  (o instalar_vps.sh gera sozinho)
JWT_SECRET=
JWT_EXPIRE_HORAS=12
# Token que o cron usa para chamar o motor de fluxos (o instalar_vps.sh gera sozinho)
CRON_TOKEN=
# Segredo no caminho do webhook do WhatsApp (/webhook/{id}/{WEBHOOK_SECRET})
WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:////opt/santoslourenco/SISTEMA/backend/sistema_sl.db
SISTEMA_DB=/opt/santoslourenco/SISTEMA/backend/sistema_sl.db
SL_CONFIG_DIR=/opt/santoslourenco/config
SL_MEDIA_DIR=/opt/santoslourenco/media
SL_PRODUCAO_DIR=/opt/santoslourenco/producao

# ---------- Escritorio (aparece em telas, pecas, contratos e mensagens) ----------
ESCRITORIO_NOME=Santos Lourenço Advogados
ESCRITORIO_NOME_CURTO=Santos Lourenço
ESCRITORIO_RAZAO_SOCIAL=
ESCRITORIO_CNPJ=
ESCRITORIO_OAB_SOCIEDADE=
ESCRITORIO_ENDERECO=
ESCRITORIO_CIDADE=Suzano
ESCRITORIO_UF=SP
ESCRITORIO_EMAIL=
# A CONFIRMAR
ESCRITORIO_DOMINIO=sistema.santoslourenco.adv.br
ADVOGADO_TITULAR_NOME=
ADVOGADO_TITULAR_OAB=
# Quem assina, revisa e e dona das tarefas
ADVOGADA_RESPONSAVEL_NOME=
ADVOGADA_RESPONSAVEL_OAB=
ADVOGADA_RESPONSAVEL_TEL=
# E-mails de login da equipe inicial (seed_equipe.py)
EQUIPE_EMAIL_JOAB=
EQUIPE_EMAIL_VITORIA=

# ---------- VPS (so na maquina de quem faz deploy) ----------
VPS_HOST=
VPS_USER=root
VPS_PORT=22
VPS_SSH_KEY=
VPS_PASS=
VPS_DIR=/opt/santoslourenco
VPS_SERVICO=sl-sistema.service

# ---------- WhatsApp (sessao D-API; linha fixa dos reclamantes) ----------
DAPI_TOKEN=
DAPI_SESSION=
DAPI_NUMERO_ID=
# Telefones que recebem avisos internos (formato 55DDDNUMERO)
CONTROLADORIA_ALERTA_ON=true
CONTROLADORIA_ALERTA_TEL=
CONTROLADORIA_LEMBRETE_ON=true
CONTROLADORIA_LEMBRETE_DIAS=3
QUENTES_AVISO_TEL=
ASSINATURA_ALERTA_TEL=
DISTRIBUICAO_AVISO_TEL=
DISTRIBUICAO_RESPONSAVEL=
DISTRIBUICAO_JANELA=
SENTINELA_DESTINO=
RELATORIO_FLUXOS_DESTINO=
FILA_LIGACAO_DESTINO=
SL_TAREFAS_DESTINO=
FLUXO_SAIU_VENDEDORA=
FLUXO_SAIU_RESUMO=
FLUXO_REVISITA_DIAS=
ALARME_MAX=
ALARME_JANELA_DIAS=
ASSINATURA_JANELA=
ASSINATURA_HORAS_FOLGA=
ASSINATURA_COOLDOWN_DIAS=
ASSINATURA_TOQUES_SOCORRO=

# ---------- IA ----------
ANTHROPIC_API_KEY=
# Opcional: Claude Code da assinatura via ponte local (servico sl-claude-ponte)
SL_CLAUDE_PONTE=
SL_PONTE_TOKEN=
SL_PONTE_PORTA=8791
SL_CLAUDE_BIN=/root/.local/bin/claude
CLAUDE_CODE_OAUTH_TOKEN=
# Reserva quando a IA principal estiver sem limite
GEMINI_API_KEY=
FLUXO_MODELO=
FLUXO_MODELO_LEITURA=
SL_MODELO_INICIAL=
# Jurisprudencia real anexada nas pecas (opcional)
JURISPRUDENCIAS_AI_TOKEN=
# Transcricao de audio (Groq recomendado, ou OpenAI)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# Voz da IA na ligacao
ELEVENLABS_API_KEY=

# ---------- Sistema juridico e publicacoes ----------
# Sistema juridico externo: nenhum (padrao) | astrea
SISTEMA_JURIDICO=nenhum
# Astrea pela API interna do app (nao ha API publica). Use um usuario SO da integracao,
# sem 2 fatores: o Astrea aceita 1 sessao por usuario (se alguem entrar com ele, derruba).
# Teste: python INTEGRACOES/astrea_client.py diagnostico
ASTREA_USUARIO=
ASTREA_SENHA=
# Responsaveis cujos processos NUNCA entram no sistema (e-mail de login no Astrea ou nome
# completo, separados por virgula). Se algum nao for achado no Astrea, nada e importado.
ASTREA_EXCLUIR_RESPONSAVEIS=
# Quem fica como responsavel dos processos importados (a tela de processos filtra por ele)
ASTREA_RESPONSAVEL_PADRAO=Vitória
# Opcionais
#ASTREA_DOMINIO=https://app.astrea.net.br
#ASTREA_LOGINS_HORA=6
# Legado/opcional
ADVBOX_API_TOKEN=
# SNC/SYNC: publicacoes, intimacoes e autos
SYNC_API_TOKEN=
SYNC_API_BASE=
SYNC_CACHE_SEGUNDOS=300

# ---------- Google (projeto Cloud PROPRIO do escritorio) ----------
GOOGLE_OAUTH_CREDENTIALS=/opt/santoslourenco/config/oauth_credentials.json
SL_TOKEN_GOOGLE=/opt/santoslourenco/config/token.json
GOOGLE_APPLICATION_CREDENTIALS=
SL_GOOGLE_SA=
# Pasta-mae dos clientes no Drive (ID da pasta)
GOOGLE_PASTA_RECLAMANTE=
GOOGLE_PASTA_LEADS_DOCS_NOME=
GOOGLE_SHEETS_CONTRATOS_ID=
# Agenda do escritorio (ID do calendario)
GCAL_SL_ID=

# ---------- OneDrive/SharePoint (so se o escritorio ficar no OneDrive) ----------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---------- E-mail (leitura diaria e envio) ----------
SL_SMTP_USUARIO=
SL_SMTP_SENHA=
SL_EMAIL_REMETENTE=

# ---------- Assinatura digital e cobranca ----------
ZAPSIGN_API_TOKEN=
ZAPSIGN_USER_TOKEN=
ZAPSIGN_AUTH_MODE=
ASAAS_API_TOKEN=

# ---------- Telefonia fora do WhatsApp (opcional) ----------
TELEFONIA_CHAVE=
NVOIP_CANAIS=

# ---------- Marketing (Meta) ----------
META_ADS_TOKEN=
META_AD_ACCOUNT=
META_PAGE_ID=
META_PIXEL_ID=
META_VALOR_CONTRATO=
TETO_MIDIA_MES=
INSTAGRAM_ID=
INSTAGRAM_TOKEN=

# ---------- Portal do Cliente / NPS ----------
NPS_TOKEN=
