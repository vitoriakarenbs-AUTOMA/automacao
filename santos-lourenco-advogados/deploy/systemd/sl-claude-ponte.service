# OPCIONAL: ponte para usar o Claude Code da ASSINATURA do escritorio no lugar de credito de API.
# So ligar depois de logar o Claude Code como root na VPS (claude login) e criar
# /opt/santoslourenco/config/claude_ponte.json com os tetos diarios.
[Unit]
Description=Santos Lourenço - ponte do Claude Code (assinatura)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/santoslourenco/producao
Environment="HOME=/root"
Environment="PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="SL_CONFIG_ENV=/opt/santoslourenco/config/.env"
ExecStart=/opt/santoslourenco/venv/bin/python /opt/santoslourenco/SYNC/claude_ponte.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
